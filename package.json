{
    "name": "pingsystem",
    "version": "0.0.1",
    "main": "index.js",
    "type": "module",
    "scripts": {
        "build": "tsup",
        "dev": "tsup --watch",
        "start": "node dist/index.js",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "env:check": "pnpx envnix validate",
        "typecheck": "tsc --noEmit"
    },
    "devDependencies": {
        "@types/node": "^26.1.2",
        "prettier": "^3.9.6",
        "tsup": "^8.5.1",
        "typescript": "^7.0.2"
    },
    "dependencies": {
        "dotenv": "^17.4.2"
    }
}
